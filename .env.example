PORT=3001
APP_ORIGIN=http://localhost:5173
# At least 32 random characters. Changing it makes stored API keys unreadable.
ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_PATH=./data/llm-compare.sqlite
REQUEST_TIMEOUT_MS=120000

# Встроенные демо-модели для страницы /x/ (доступны всем посетителям без регистрации).
# Ключ остаётся только на сервере. Формат DEMO_MODELS: Название|Провайдер|model_id через запятую.
# DEMO_BASE_URL=https://api.timeweb.ai/v1
# DEMO_API_KEY=sk-...
# DEMO_MODELS=GPT-4o mini|OpenAI|openai/gpt-4o-mini,Claude Haiku|Anthropic|anthropic/claude-haiku-4-5
